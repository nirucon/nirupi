# NIRU — NIRU Ink. Same schema as tokens.env.
# NIRUPI's own signature: near-black paper with a single patinated-copper
# accent, everything else held in ink-wash greys.
# Apply with: nirupi theme set ink
NOIR_THEME_NAME="NIRU Ink"
NOIR_THEME_DESC="Near-black ink wash with a single patinated-copper accent"

NOIR_BG=0e0f12
NOIR_FG=ded4c6
NOIR_MUTED=8b8378
NOIR_SELECTION=1d1f24
NOIR_BORDER=33363d
NOIR_FOCUS=c08a5e
NOIR_FONT="JetBrainsMono Nerd Font"
NOIR_FONT_SIZE=11

# ANSI 0-7 (normal)
NOIR_ANSI_0=1d1f24
NOIR_ANSI_1=a9603f
NOIR_ANSI_2=7d8f68
NOIR_ANSI_3=c08a5e
NOIR_ANSI_4=7f8a9c
NOIR_ANSI_5=9a7f92
NOIR_ANSI_6=8fa39b
NOIR_ANSI_7=ded4c6
# ANSI 8-15 (bright)
NOIR_ANSI_8=4c4f57
NOIR_ANSI_9=d08a5e
NOIR_ANSI_10=a6b78c
NOIR_ANSI_11=e0b183
NOIR_ANSI_12=a3adc0
NOIR_ANSI_13=c2a6bd
NOIR_ANSI_14=b8ccc3
NOIR_ANSI_15=f5efe4
