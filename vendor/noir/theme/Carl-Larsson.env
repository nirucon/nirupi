# NIRU — Carl Larsson theme. Same schema as tokens.env.
# A warm, earthy, painterly dark palette drawn from Carl Larsson's watercolours
# of his home and children (deep umber, cream, falu red, sage, ochre, dusty blue).
# Apply with: nirupi theme set carl-larsson
NOIR_THEME_NAME="Carl Larsson"
NOIR_THEME_DESC="Warm umber, cream and earthy watercolour accents"

NOIR_BG=241a16
NOIR_FG=efe6d8
NOIR_MUTED=bcae99
NOIR_SELECTION=46362c
NOIR_BORDER=33261f
NOIR_FOCUS=6e5648
NOIR_FONT="JetBrainsMono Nerd Font"
NOIR_FONT_SIZE=11

# ANSI 0-7 (normal)
NOIR_ANSI_0=241a16
NOIR_ANSI_1=cf7e63
NOIR_ANSI_2=92a36e
NOIR_ANSI_3=c9a24e
NOIR_ANSI_4=809dbe
NOIR_ANSI_5=b98a99
NOIR_ANSI_6=7fada2
NOIR_ANSI_7=efe6d8
# ANSI 8-15 (bright)
NOIR_ANSI_8=6e5648
NOIR_ANSI_9=d07a5f
NOIR_ANSI_10=9fb073
NOIR_ANSI_11=e0bb63
NOIR_ANSI_12=8aa7c2
NOIR_ANSI_13=bd8ea0
