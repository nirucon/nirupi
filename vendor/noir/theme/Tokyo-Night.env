# NIRU — Tokyo Night. Same schema as tokens.env.
# Cool, modern night sky: deep indigo base with blue/magenta/cyan accents.
# Apply with: nirupi theme set tokyo-night
NOIR_THEME_NAME="Tokyo Night"
NOIR_THEME_DESC="Cool indigo night with blue, magenta and cyan accents"

NOIR_BG=1a1b26
NOIR_FG=a9b1d6
NOIR_MUTED=565f89
NOIR_SELECTION=292e42
NOIR_BORDER=3b4261
NOIR_FOCUS=7aa2f7
NOIR_FONT="JetBrainsMono Nerd Font"
NOIR_FONT_SIZE=11

# ANSI 0-7 (normal)
NOIR_ANSI_0=32344a
NOIR_ANSI_1=f7768e
NOIR_ANSI_2=9ece6a
NOIR_ANSI_3=e0af68
NOIR_ANSI_4=7aa2f7
NOIR_ANSI_5=ad8ee6
NOIR_ANSI_6=449dab
NOIR_ANSI_7=a9b1d6
# ANSI 8-15 (bright)
NOIR_ANSI_8=565f89
NOIR_ANSI_9=ff7a93
NOIR_ANSI_10=b9f27a
NOIR_ANSI_11=e6c17a
NOIR_ANSI_12=7da6ff
NOIR_ANSI_13=bb9af7
