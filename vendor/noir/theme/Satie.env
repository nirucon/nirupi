# NIRU — Satie theme. Same schema as tokens.env.
# A quiet, flat, monochrome graphite palette with a single muted-gold accent,
# after Erik Satie's sparse and measured aesthetic.
# Apply with: nirupi theme set satie
NOIR_THEME_NAME="Satie"
NOIR_THEME_DESC="Monochrome graphite, quiet, one muted-gold accent"

NOIR_BG=1a1a1c
NOIR_FG=dcdcdc
NOIR_MUTED=9a9a9a
NOIR_SELECTION=34343a
NOIR_BORDER=28282c
NOIR_FOCUS=5c5c64
NOIR_FONT="JetBrainsMono Nerd Font"
NOIR_FONT_SIZE=11

# ANSI 0-7 (normal)
NOIR_ANSI_0=1a1a1c
NOIR_ANSI_1=b08a86
NOIR_ANSI_2=8f9c84
NOIR_ANSI_3=c2b184
NOIR_ANSI_4=8a97a8
NOIR_ANSI_5=a597a6
NOIR_ANSI_6=8fa6a3
NOIR_ANSI_7=dcdcdc
# ANSI 8-15 (bright)
NOIR_ANSI_8=5c5c64
NOIR_ANSI_9=c9a19c
NOIR_ANSI_10=a7b49b
NOIR_ANSI_11=d8c79a
NOIR_ANSI_12=a6b3c4
NOIR_ANSI_13=c0b1c1
NOIR_ANSI_14=a6c0bc
NOIR_ANSI_15=f2f0ea
