# NIRU — Satie theme. Same schema as tokens.env.
# A quiet, flat, monochrome graphite palette with a single muted-gold accent,
# after Erik Satie's sparse and measured aesthetic. Deliberately lighter and
# greyer than Noir so the two are easy to tell apart.
# Apply with: nirupi theme set satie
NOIR_THEME_NAME="Satie"
NOIR_THEME_DESC="Flat monochrome graphite, one muted-gold accent"

NOIR_BG=232326
NOIR_FG=e6e6e6
NOIR_MUTED=a0a0a4
NOIR_SELECTION=35353b
NOIR_BORDER=2c2c31
NOIR_FOCUS=5f5f68
NOIR_FONT="JetBrainsMono Nerd Font"
NOIR_FONT_SIZE=11

# ANSI 0-7 (normal) — near-neutral greys; only the yellow slot is the accent
NOIR_ANSI_0=232326
NOIR_ANSI_1=a89a97
NOIR_ANSI_2=9aa39a
NOIR_ANSI_3=c9b27e
NOIR_ANSI_4=96a0ad
NOIR_ANSI_5=a9a2ad
NOIR_ANSI_6=97a5a3
NOIR_ANSI_7=e6e6e6
# ANSI 8-15 (bright)
NOIR_ANSI_8=5f5f68
NOIR_ANSI_9=c6b6b2
NOIR_ANSI_10=b6bfb5
NOIR_ANSI_11=e0cd9a
NOIR_ANSI_12=b2bccb
NOIR_ANSI_13=c6bfca
NOIR_ANSI_14=b3c2bf
NOIR_ANSI_15=f4f4f6
