# NIRU Noir — single source of truth for palette and typography.
# Consumed by lib/theme.sh and validated by tests/noir-consistency.sh.
# Values are hex without a leading '#'.
NOIR_THEME_NAME="Noir"
NOIR_THEME_DESC="Cold, near-black monochrome (default)"

NOIR_BG=0f0f10
NOIR_FG=e5e5e5
NOIR_MUTED=a8a8a8
NOIR_SELECTION=3a3a3d
NOIR_BORDER=2a2a2d
NOIR_FOCUS=5a5a60
NOIR_FONT="JetBrainsMono Nerd Font"
NOIR_FONT_SIZE=11

# ANSI 0-7 (normal)
NOIR_ANSI_0=0f0f10
NOIR_ANSI_1=b87878
NOIR_ANSI_2=83a18b
NOIR_ANSI_3=b5a47e
NOIR_ANSI_4=819eb5
NOIR_ANSI_5=a390b0
NOIR_ANSI_6=83a9a7
NOIR_ANSI_7=e5e5e5
# ANSI 8-15 (bright)
NOIR_ANSI_8=5a5a60
NOIR_ANSI_9=d69a9a
NOIR_ANSI_10=a4c5aa
NOIR_ANSI_11=d2c092
NOIR_ANSI_12=a4bfd3
NOIR_ANSI_13=c0a9cc
NOIR_ANSI_14=a4cbca
NOIR_ANSI_15=ffffff
