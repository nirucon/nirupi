# NIRU — Commando (camo). Same schema as tokens.env.
# Field-camo at dusk: olive, khaki and clay over a deep woodland base, with a
# single hi-vis amber so alerts still read like a signal flare.
# Apply with: nirupi theme set commando
NOIR_THEME_NAME="Commando"
NOIR_THEME_DESC="Field camo at dusk — olive, khaki and clay with hi-vis amber"

NOIR_BG=1b211a
NOIR_FG=d6d3b8
NOIR_MUTED=8f9378
NOIR_SELECTION=39402f
NOIR_BORDER=4a5240
NOIR_FOCUS=b08d4a
NOIR_FONT="JetBrainsMono Nerd Font"
NOIR_FONT_SIZE=11

# ANSI 0-7 (normal)
NOIR_ANSI_0=2a3126
NOIR_ANSI_1=a2563f
NOIR_ANSI_2=6b7a4a
NOIR_ANSI_3=b08d4a
NOIR_ANSI_4=5c7360
NOIR_ANSI_5=8a6b6b
NOIR_ANSI_6=7d8f79
NOIR_ANSI_7=d6d3b8
# ANSI 8-15 (bright)
NOIR_ANSI_8=525a45
NOIR_ANSI_9=c4705a
NOIR_ANSI_10=8c9e63
NOIR_ANSI_11=d2a95e
NOIR_ANSI_12=7c9482
NOIR_ANSI_13=a88a8a
NOIR_ANSI_14=9db099
NOIR_ANSI_15=eeeccf
