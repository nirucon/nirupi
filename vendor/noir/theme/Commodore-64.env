# NIRU — Commodore 64. Same schema as tokens.env.
# The iconic VIC-II palette: the blue screen and light-blue text everyone
# remembers, with the full 16-colour hardware palette mapped to ANSI.
# Muted just enough for long sessions on a modern panel.
# Apply with: nirupi theme set c64
NOIR_THEME_NAME="Commodore 64"
NOIR_THEME_DESC="VIC-II blue screen and light-blue PETSCII text"

NOIR_BG=40318d
NOIR_FG=a6a0e0
NOIR_MUTED=7b71d6
NOIR_SELECTION=5a4fb0
NOIR_BORDER=8b7fe8
NOIR_FOCUS=bfce72
NOIR_FONT="JetBrainsMono Nerd Font"
NOIR_FONT_SIZE=11

# ANSI 0-7 (normal) — VIC-II colours
NOIR_ANSI_0=40318d
NOIR_ANSI_1=883932
NOIR_ANSI_2=55a049
NOIR_ANSI_3=bfce72
NOIR_ANSI_4=5a4fb0
NOIR_ANSI_5=8b3f96
NOIR_ANSI_6=67b6bd
NOIR_ANSI_7=a6a0e0
# ANSI 8-15 (bright)
NOIR_ANSI_8=7b71d6
NOIR_ANSI_9=a85a54
NOIR_ANSI_10=77b96b
NOIR_ANSI_11=dfe08a
NOIR_ANSI_12=8b7fe8
NOIR_ANSI_13=b069ba
NOIR_ANSI_14=93dde2
NOIR_ANSI_15=e8e6ff
