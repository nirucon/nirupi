# NIRU — Gruvbox Dark. Same schema as tokens.env.
# The warm, retro-groove palette: soft dark brown base with warm foregrounds
# and muted yellow/orange/red accents. Easy on the eyes at night.
# Apply with: nirupi theme set gruvbox
NOIR_THEME_NAME="Gruvbox dark"
NOIR_THEME_DESC="Warm retro groove — soft brown base with yellow/orange accents"

NOIR_BG=282828
NOIR_FG=ebdbb2
NOIR_MUTED=a89984
NOIR_SELECTION=3c3836
NOIR_BORDER=504945
NOIR_FOCUS=d79921
NOIR_FONT="JetBrainsMono Nerd Font"
NOIR_FONT_SIZE=11

# ANSI 0-7 (normal)
NOIR_ANSI_0=3c3836
NOIR_ANSI_1=cc241d
NOIR_ANSI_2=98971a
NOIR_ANSI_3=d79921
NOIR_ANSI_4=458588
NOIR_ANSI_5=b16286
NOIR_ANSI_6=689d6a
NOIR_ANSI_7=a89984
# ANSI 8-15 (bright)
NOIR_ANSI_8=928374
NOIR_ANSI_9=fb4934
NOIR_ANSI_10=b8bb26
NOIR_ANSI_11=fabd2f
NOIR_ANSI_12=83a598
NOIR_ANSI_13=d3869b
NOIR_ANSI_14=8ec07c
NOIR_ANSI_15=ebdbb2
