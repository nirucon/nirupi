# NIRU — Nord dark theme. Same schema as tokens.env.
# The Nord palette: Polar Night backgrounds with the Frost and Aurora accents.
# The aurora red/magenta are lifted slightly from the original values so they
# stay legible on the Nord background in a terminal.
# Apply with: nirupi theme set nord-dark
NOIR_THEME_NAME="Nord dark"
NOIR_THEME_DESC="Polar Night blues with the Nord frost and aurora accents"

NOIR_BG=2e3440
NOIR_FG=d8dee9
NOIR_MUTED=98a3b8
NOIR_SELECTION=434c5e
NOIR_BORDER=3b4252
NOIR_FOCUS=5e81ac
NOIR_FONT="JetBrainsMono Nerd Font"
NOIR_FONT_SIZE=11

# ANSI 0-7 (normal) — Nord terminal mapping (aurora red/magenta lifted)
NOIR_ANSI_0=3b4252
NOIR_ANSI_1=d18a93
NOIR_ANSI_2=a3be8c
NOIR_ANSI_3=ebcb8b
NOIR_ANSI_4=81a1c1
NOIR_ANSI_5=c3a0c5
NOIR_ANSI_6=88c0d0
NOIR_ANSI_7=e5e9f0
# ANSI 8-15 (bright)
NOIR_ANSI_8=4c566a
NOIR_ANSI_9=d78f97
NOIR_ANSI_10=a3be8c
NOIR_ANSI_11=ebcb8b
NOIR_ANSI_12=93b2d2
NOIR_ANSI_13=d3aed2
NOIR_ANSI_14=8fbcbb
NOIR_ANSI_15=eceff4
