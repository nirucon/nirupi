# NIRU — Hackerman theme. Same schema as tokens.env.
# A CRT phosphor-green terminal on black: green dominates the surface, with a
# handful of functional accents so diagnostics stay readable.
# Apply with: nirupi theme set hackerman
NOIR_THEME_NAME="Hackerman"
NOIR_THEME_DESC="Phosphor green on black — CRT hacker terminal"

NOIR_BG=0a0f0a
NOIR_FG=b6f2b6
NOIR_MUTED=6f9e73
NOIR_SELECTION=14361a
NOIR_BORDER=123014
NOIR_FOCUS=2f7a3a
NOIR_FONT="JetBrainsMono Nerd Font"
NOIR_FONT_SIZE=11

# ANSI 0-7 (normal)
NOIR_ANSI_0=0a0f0a
NOIR_ANSI_1=e05f5f
NOIR_ANSI_2=4fe07a
NOIR_ANSI_3=d7e05f
NOIR_ANSI_4=5fc7e0
NOIR_ANSI_5=cf7fe0
NOIR_ANSI_6=5fe0c7
NOIR_ANSI_7=b6f2b6
# ANSI 8-15 (bright)
NOIR_ANSI_8=2f7a3a
NOIR_ANSI_9=ff8a8a
NOIR_ANSI_10=8dffab
NOIR_ANSI_11=eaff8f
NOIR_ANSI_12=8fd8ff
NOIR_ANSI_13=eaa8ff
NOIR_ANSI_14=8ffff0
NOIR_ANSI_15=ecffec
