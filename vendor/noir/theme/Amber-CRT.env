# NIRU — Amber CRT. Same schema as tokens.env.
# Monochrome amber phosphor, like a late-70s terminal: one hue, many shades.
# Apply with: nirupi theme set amber
NOIR_THEME_NAME="Amber CRT"
NOIR_THEME_DESC="Monochrome amber phosphor terminal"

NOIR_BG=0b0906
NOIR_FG=ffb000
NOIR_MUTED=9a6a1e
NOIR_SELECTION=2e1f07
NOIR_BORDER=4a3410
NOIR_FOCUS=ffc94d
NOIR_FONT="JetBrainsMono Nerd Font"
NOIR_FONT_SIZE=11

# ANSI 0-7 (normal)
NOIR_ANSI_0=1a1206
NOIR_ANSI_1=d96a00
NOIR_ANSI_2=b8860e
NOIR_ANSI_3=ffb000
NOIR_ANSI_4=c48012
NOIR_ANSI_5=b87a1a
NOIR_ANSI_6=e0a020
NOIR_ANSI_7=ffd280
# ANSI 8-15 (bright)
NOIR_ANSI_8=7a5613
NOIR_ANSI_9=ff8c1a
NOIR_ANSI_10=e0a020
NOIR_ANSI_11=ffc94d
NOIR_ANSI_12=ffb000
NOIR_ANSI_13=e8a83a
NOIR_ANSI_14=ffdd99
NOIR_ANSI_15=ffe8b8
