# NIRU — Noir day theme. Same schema as tokens.env.
# A light "paper" take on Noir for daylight: warm off-white background with
# dark, readable accents. On a light surface the "bright" slots are *darker*
# (higher contrast) so bold text still pops.
# Apply with: nirupi theme set noir-day
NOIR_THEME_NAME="Noir day"
NOIR_THEME_DESC="Light warm paper — readable in daylight"

NOIR_BG=f4f1ea
NOIR_FG=2f2c27
NOIR_MUTED=6f6a62
NOIR_SELECTION=ded9cf
NOIR_BORDER=d6d1c7
NOIR_FOCUS=9a9488
NOIR_FONT="JetBrainsMono Nerd Font"
NOIR_FONT_SIZE=11

# ANSI 0-7 (normal)
NOIR_ANSI_0=3a3733
NOIR_ANSI_1=b04a3a
NOIR_ANSI_2=4f7434
NOIR_ANSI_3=856611
NOIR_ANSI_4=3a6ea5
NOIR_ANSI_5=8a4f9e
NOIR_ANSI_6=2b7373
NOIR_ANSI_7=6f6a62
# ANSI 8-15 (bright) — darker on purpose (light surface)
NOIR_ANSI_8=948d80
NOIR_ANSI_9=9c3d2e
NOIR_ANSI_10=42682a
NOIR_ANSI_11=755b10
NOIR_ANSI_12=2d5c92
NOIR_ANSI_13=743a89
NOIR_ANSI_14=1f6060
NOIR_ANSI_15=3a3631
