# NIRU — dunst base settings.
# Colours (font, frame/separator colour and urgency palettes) are generated from
# the active theme into dunstrc.d/90-nirupi.conf, which outranks this file.
# Do not set colours here; run `nirupi theme apply` after changing themes.
[global]
    frame_width = 2
    separator_height = 1
    transparency = 0
    corner_radius = 4
    padding = 10
    horizontal_padding = 12
    vertical_padding = 8
    text_icon_padding = 6
    icon_position = left
    markup = yes
    alignment = left
    word_wrap = yes
    format = "<b>%s</b>\n%b"
    follow = keyboard
    stack_duplicates = true
    hide_duplicate_count = true
    show_indicators = no
