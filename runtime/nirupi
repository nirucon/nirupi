#!/usr/bin/env bash
set -euo pipefail

# Best-effort, safe provisioning for `nirupi doctor --fix`.
niru_doctor_fix(){
  local changed=0 fam dir tmp
  if command -v fc-match >/dev/null 2>&1; then
    fam="$(fc-match -f '%{family}' 'JetBrainsMono Nerd Font' 2>/dev/null || :)"
    case "$fam" in
      *Nerd*) printf 'OK   Nerd Font already present (%s)\n' "$fam";;
      *)
        if command -v curl >/dev/null 2>&1 && command -v unzip >/dev/null 2>&1; then
          printf 'FIX  installing JetBrainsMono Nerd Font to ~/.local/share/fonts\n'
          dir="$HOME/.local/share/fonts/JetBrainsMonoNerd"; mkdir -p "$dir"
          tmp="$(mktemp -d)"
          if curl -fsSL "${NIRUPI_NERD_FONT_URL:-https://github.com/ryanoasis/nerd-fonts/releases/download/v3.2.1/JetBrainsMono.zip}" -o "$tmp/f.zip" \
             && unzip -oq "$tmp/f.zip" -d "$dir"; then
            command -v fc-cache >/dev/null 2>&1 && fc-cache -f "$dir" >/dev/null 2>&1 || :
            changed=1
          else printf 'WARN Nerd Font download failed (offline?)\n' >&2; fi
          rm -rf -- "$tmp"
        else printf 'WARN install curl+unzip to provision the Nerd Font\n' >&2; fi;;
    esac
  fi

  if ! command -v xidlehook >/dev/null 2>&1 && ! command -v xautolock >/dev/null 2>&1 && ! command -v xss-lock >/dev/null 2>&1; then
    if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
      printf 'FIX  installing xss-lock\n'
      if command -v pacman >/dev/null 2>&1; then sudo pacman -S --needed --noconfirm xss-lock && changed=1
      elif command -v apt-get >/dev/null 2>&1; then sudo apt-get install -y xss-lock && changed=1
      elif command -v xbps-install >/dev/null 2>&1; then sudo xbps-install -Sy xss-lock && changed=1
      else printf 'WARN unknown package manager; install xss-lock manually\n' >&2; fi
    else
      printf 'HINT no passwordless sudo; install xss-lock, xidlehook or xautolock for auto-lock\n' >&2
    fi
  else
    printf 'OK   idle-lock tool present\n'
  fi

  # setuid slock: the lock keybinding needs a privileged locker.
  local slock_path built
  slock_path="$(command -v slock 2>/dev/null || true)"
  if [[ -n $slock_path && -u $slock_path ]]; then
    printf 'OK   slock is setuid (%s)\n' "$slock_path"
  else
    built="$(ls "$HOME"/.local/lib/nirupi/*/bin/slock 2>/dev/null | tail -n1)"
    if [[ -n $built && -x $built ]] && command -v sudo >/dev/null 2>&1; then
      printf 'FIX  installing setuid slock to /usr/local/bin/slock\n'
      if sudo install -o root -g root -m 4755 "$built" /usr/local/bin/slock; then changed=1
      else printf 'WARN could not install setuid slock\n' >&2; fi
    else
      printf 'HINT a setuid slock is required for the lock keybinding (NIRUPI --apply does this)\n'
    fi
  fi

  (( changed )) && printf 'FIX  applied\n' || printf 'OK   nothing to fix\n'
}

cmd="${1:-help}"; shift || :
nirupi_help(){
  local t="${1:-}" text
  text="$(cat <<'EOF'
NIRUPI — helper CLI

Themes
  nirupi theme list                  list themes
  nirupi theme preview NAME          show a palette's colours
  nirupi theme set NAME              apply a theme live (Super+Ctrl+t picker)
  nirupi theme menu                  rofi theme picker
  nirupi theme wallpaper IMAGE       derive a palette from an image
  nirupi theme mode noir|wallpaper|palette

Wallpaper
  nirupi wallpaper set FILE                 set an image on every output
  nirupi wallpaper next                     random image from the pool
  nirupi wallpaper per-tag on|off|toggle|status   per-workspace backgrounds

Session & apps
  nirupi menu | nirupi keys | nirupi lock
  nirupi launch                      unified launcher (also Super+Shift+p)
  nirupi autostart list|run          login autostart entries (per workspace)
  nirupi notifications               dunst notification history
  nirupi usb                         mount/unmount removable drives
  nirupi lid                         laptop lid-close behaviour (systemd)
  nirupi calendar                    month view (optional Google iCal sync)
  nirupi barmode                     cycle bar: padded -> full-bleed -> none
  nirupi changes [VERSION]           show the changelog for a version
  nirupi fleet                       read-only status across fleet.conf hosts
  nirupi ssh                         pick a host (~/.ssh/config + Tailscale)
  nirupi edit [TOPIC]                open a NIRUPI config in $EDITOR
  nirupi reload                      rebuild dwm if needed + restart in place
  nirupi agent [profile]             AI agent (opencode)
  nirupi explain                     diagnose the system with the agent
  nirupi mission [NAME]              open a named workspace/app set
  nirupi dwm state|tag N|layout NAME scriptable dwm control
  nirupi webapp add|list|remove      Chromium app-mode web apps
  nirupi browser status|set|reset    default browser
  nirupi updates [--refresh]         system/Git update counts
  nirupi repos status|pull --all     inspect or fast-forward ~/Git

Maintenance
  nirupi status --once|--json        status-bar output
  nirupi doctor [--fix]              diagnose fonts/tools/theme
  nirupi backup [--list|--verify FILE|--restore FILE|--schedule|--unschedule]
  nirupi snapshot status|create|list system snapshot before updates
  nirupi tune status|plan|apply|revert reversible system tuning
  nirupi gc --dry-run|--yes|--legacy|--system prune old versions/backups
  nirupi update                      self-update (git pull + steps)
  nirupi rollback --all|--configs RUN|--binaries
  nirupi migrate plan|dwm --rebuild|binaries --rebuild

See docs/USAGE.md and docs/KEYBINDINGS.md in the source tree.
EOF
)"
  if [[ -z $t ]]; then printf '%s\n' "$text"; return 0; fi
  if printf '%s\n' "$text" | grep -qiE "(^|[[:space:]])${t}([[:space:]]|$)"; then
    printf '%s\n' "$text" | grep -iE "(^|[[:space:]])${t}([[:space:]]|$)"
  else
    printf "No help for '%s'. Run 'nirupi help'.\n" "$t"
  fi
}
nirupi_version(){
  local v="" target
  if [[ -r "$HOME/.local/state/nirupi/installed.env" ]]; then
    v="$(sed -n 's/^NIRUPI_VERSION=//p' "$HOME/.local/state/nirupi/installed.env" | head -n1)"
  fi
  if [[ -z $v ]]; then
    target="$(readlink "$HOME/.local/bin/dwm" 2>/dev/null || true)"
    [[ $target =~ /nirupi/([^/]+)/ ]] && v="${BASH_REMATCH[1]}"
  fi
  printf '%s' "${v:-unknown}"
}

# doctor: collect "<STATUS>\t<name>\t<detail>" rows, then print text or JSON.
_jq(){ printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
DROWS=()
drow(){ DROWS+=("$1"$'\t'"$2"$'\t'"${3:-}"); }
nirupi_doctor(){
  local json=0 app pid running ID="" row s n d fail=0
  [[ ${1:-} == --json ]] && json=1
  DROWS=()
  for app in dwm dmenu st nirupi-session dwm-status.sh nirupi-updates nirupi-browser; do
    if [[ -x $HOME/.local/bin/$app ]]; then drow OK "$app"; else drow FAIL "$app" "not installed"; fi
  done
  for app in Xorg xsetroot kitty rofi opencode slock xss-lock xidlehook xautolock nextcloud xinput ffmpeg gpg; do
    if command -v "$app" >/dev/null 2>&1; then drow OK "$app"; else drow WARN "$app" "missing"; fi
  done
  [[ -r /etc/os-release ]] && . /etc/os-release && ID="${ID:-}"
  # Idle: name the engine that will actually be used, and be honest that
  # xidlehook/xautolock are not packaged on Arch/Debian/Void.
  if command -v xidlehook >/dev/null 2>&1; then
    drow OK idle "xidlehook (dim, lock, DPMS, suspend)"
  elif command -v xautolock >/dev/null 2>&1; then
    drow OK idle "xautolock (lock)"
  elif command -v xss-lock >/dev/null 2>&1; then
    drow OK idle "xss-lock (lock + DPMS via xset)"
  else
    drow HINT idle "no idle tool: install xss-lock for lock, or xidlehook (AUR/cargo on Arch)"
  fi
  command -v nmcli >/dev/null 2>&1 || drow HINT networkmanager "install NetworkManager (nmcli) for the Wi-Fi menu"
  case "$ID" in
    arch|cachyos)
      command -v yay >/dev/null 2>&1 || command -v paru >/dev/null 2>&1 || \
        drow HINT aur "no AUR helper (yay/paru); AUR apps install from upstream tarballs";;
  esac
  command -v man >/dev/null 2>&1 || drow HINT man-db "install man-db so 'man nirupi' works"
  ls /usr/share/bash-completion/bash_completion >/dev/null 2>&1 || drow HINT bash-completion "install the bash-completion package for shell completions"
  if command -v tailscale >/dev/null 2>&1; then
    if command -v systemctl >/dev/null 2>&1; then
      systemctl is-enabled tailscaled >/dev/null 2>&1 || drow HINT tailscaled "enable Tailscale at boot: sudo systemctl enable --now tailscaled"
    elif command -v sv >/dev/null 2>&1; then
      [[ -e /var/service/tailscaled ]] || drow HINT tailscaled "enable Tailscale at boot: sudo ln -s /etc/sv/tailscaled /var/service/"
    fi
  fi
  if command -v wpctl >/dev/null 2>&1 && wpctl status >/dev/null 2>&1 \
     && ! wpctl status 2>/dev/null | grep -q 'Sinks:'; then
    drow HINT audio "no audio output found; on Intel install sof-firmware + alsa-ucm-conf"
  fi
  case "$ID" in
    debian)
      if ! grep -rsq 'non-free-firmware' /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null; then
        drow HINT non-free-firmware "Debian has no non-free-firmware component; Intel audio firmware/microcode may be missing"
      fi;;
  esac
  [[ -e /usr/share/xsessions/nirupi-dwm.desktop ]] && drow OK x11-session || drow WARN x11-session "missing"
  if [[ $ID == void ]]; then
    if [[ -L /var/service/sddm ]]; then drow OK runit-sddm "service symlink"; else drow INFO runit-sddm "not enabled (or using startx)"; fi
  fi
  if command -v pgrep >/dev/null 2>&1; then
    pid="$(pgrep -u "$(id -u)" -x dwm | head -n 1 || true)"
    if [[ -n $pid && -e /proc/$pid/exe ]]; then
      running="$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)"
      if [[ $running == "$HOME/.local/lib/nirupi/"*"/bin/dwm" ]]; then drow OK running-dwm "$running"; else drow INFO running-dwm "${running:-unknown}"; fi
    fi
  fi
  # Session: warn if dwm runs outside the NIRUPI session (features off).
  if command -v pgrep >/dev/null 2>&1; then
    if pgrep -f nirupi-session >/dev/null 2>&1; then drow OK session "nirupi-session"
    elif pgrep -x dwm >/dev/null 2>&1; then drow WARN session "dwm runs outside the NIRUPI session"
    else drow INFO session "not detected"; fi
  fi
  if [[ -f /usr/share/xsessions/dwm.desktop ]] && ! grep -q nirupi-session /usr/share/xsessions/dwm.desktop 2>/dev/null; then
    drow HINT session-file "legacy xsessions/dwm.desktop present; run --apply to repoint it"
  fi
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8*|*utf8*|*UTF8*) drow OK locale;;
    *) drow HINT locale "no UTF-8 locale set (icons/accents may render wrong)";;
  esac
  # Optional tools used by the pop-ups and toggles (all best-effort).
  for _t in xclip maim flameshot gammastep brightnessctl ffmpeg rofi tesseract satty; do
    command -v "$_t" >/dev/null 2>&1 || drow HINT "tool-$_t" "install $_t"
  done
  if (( json )); then
    printf '{"version":"%s","distro":"%s","checks":[' "$(nirupi_version)" "${ID:-unknown}"
    local first=1
    for row in "${DROWS[@]}"; do
      IFS=$'\t' read -r s n d <<<"$row"
      (( first )) || printf ','
      first=0
      printf '{"status":"%s","name":"%s","detail":"%s"}' "$(_jq "$s")" "$(_jq "$n")" "$(_jq "$d")"
    done
    printf ']}\n'
    return 0
  fi
  for row in "${DROWS[@]}"; do
    IFS=$'\t' read -r s n d <<<"$row"
    if [[ -n $d ]]; then printf '%-4s %s (%s)\n' "$s" "$n" "$d"; else printf '%-4s %s\n' "$s" "$n"; fi
    [[ $s == FAIL ]] && fail=$((fail+1))
  done
  return "$fail"
}
# Read-only performance snapshot for `nirupi doctor --perf`.
nirupi_perf(){
 local conf="${XDG_CONFIG_HOME:-$HOME/.config}/nirupi/status.conf"
 local interval=2 frame=0.3 pid a b wake
 [[ -r $conf ]] && {
  interval="$(sed -n 's/^[[:space:]]*NIRUPI_BAR_INTERVAL[[:space:]]*=[[:space:]]*//p' "$conf" | tail -n1)"
  frame="$(sed -n 's/^[[:space:]]*NOW_PLAYING_FRAME_INTERVAL[[:space:]]*=[[:space:]]*//p' "$conf" | tail -n1)"
 }
 [[ $interval =~ ^[1-9][0-9]*$ ]] || interval=2
 [[ $frame =~ ^[0-9.]+$ ]] || frame=0.3
 printf 'NIRUPI performance snapshot\n'
 printf '  bar interval       : %ss (music frame: %ss)\n' "$interval" "$frame"
 pid="$(pgrep -u "$(id -u)" -f "^bash ${HOME//\//\\/}/\.local/bin/dwm-status\.sh$" | head -n1 || true)"
 if [[ -n $pid && -r /proc/$pid/status ]]; then
  printf '  status process     : pid %s, cpu %s%%, rss %s KB\n' "$pid" \
    "$(ps -p "$pid" -o %cpu= 2>/dev/null | tr -d ' ')" "$(ps -p "$pid" -o rss= 2>/dev/null | tr -d ' ')"
  a="$(awk '$1 == "voluntary_ctxt_switches:" {print $2}' /proc/$pid/status 2>/dev/null)"
  sleep 2
  b="$(awk '$1 == "voluntary_ctxt_switches:" {print $2}' /proc/$pid/status 2>/dev/null)"
  if [[ $a =~ ^[0-9]+$ && $b =~ ^[0-9]+$ ]]; then
   wake=$(( (b - a) / 2 ))
   printf '  status wakeups     : ~%s/s (voluntary context switches)\n' "$wake"
  fi
 else
  printf '  status process     : not running\n'
 fi
 printf '  compositor         : %s\n' "$(pgrep -x picom >/dev/null 2>&1 && printf 'picom running' || printf 'off')"
 printf '  swappiness         : %s\n' "$(cat /proc/sys/vm/swappiness 2>/dev/null || printf '?')"
 printf '  cpu governor       : %s\n' "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || printf '?')"
 if command -v zramctl >/dev/null 2>&1; then
  printf '  zram               : %s\n' "$(zramctl --noheadings --output NAME,DISKSIZE,ALGORITHM 2>/dev/null | tr '\n' ' ' || true)"
 fi
 if command -v swapon >/dev/null 2>&1; then
  printf '  swap               : %s\n' "$(swapon --show=NAME,TYPE,SIZE --noheadings 2>/dev/null | tr '\n' ' ' || true)"
 fi
 if command -v findmnt >/dev/null 2>&1; then
  printf '  root               : %s (%s)\n' "$(findmnt -n -o SOURCE / 2>/dev/null)" "$(findmnt -n -o FSTYPE / 2>/dev/null)"
 fi
 if command -v systemctl >/dev/null 2>&1; then
  printf '  fstrim.timer       : %s\n' "$(systemctl is-enabled fstrim.timer 2>/dev/null || printf 'not-enabled')"
 fi
}
case "$cmd" in
  version|--version|-V) nirupi_version; printf '
';;

  browser) exec "$HOME/.local/bin/nirupi-browser" "$@";;
  appearance) exec "$HOME/.local/bin/nirupi-appearance" "$@";;
  wallpaper) exec "$HOME/.local/bin/nirupi-wallpaper.sh" "$@";;
  ssh) exec "$HOME/.local/bin/nirupi-ssh.sh" "$@";;
  autostart) exec "$HOME/.local/bin/nirupi-autostart.sh" "$@";;
  notifications) exec "$HOME/.local/bin/nirupi-notifications.sh" "$@";;
  launch) exec "$HOME/.local/bin/nirupi-launch.sh" "$@";;
  barmode) exec "$HOME/.local/bin/nirupi-barmode.sh" "$@";;
  calendar) exec "$HOME/.local/bin/nirupi-calendar.sh" "$@";;
  changes) exec "$HOME/.local/bin/nirupi-changes.sh" "$@";;
  fleet) exec "$HOME/.local/bin/nirupi-fleet.sh" "$@";;
  usb) exec "$HOME/.local/bin/nirupi-usb.sh" "$@";;
  lid) exec "$HOME/.local/bin/nirupi-lid.sh" "$@";;
  edit) exec "$HOME/.local/bin/nirupi-edit.sh" "$@";;
  reload) exec "$HOME/.local/bin/nirupi-reload.sh" "$@";;
  updates) exec "$HOME/.local/bin/nirupi-updates" "$@";;
  repos) exec "$HOME/.local/bin/nirupi-repos.sh" "$@";;
  status)
    case "${1:-}" in
      --once|--json|--bar) exec "$HOME/.local/bin/dwm-status.sh" "$1";;
    esac
    printf 'Session: %s\nDisplay: %s\n' "${XDG_SESSION_TYPE:-unknown}" "${DISPLAY:-none}"; pgrep -af '[d]wm-status.sh' || :;;
  doctor)
    fix=0; json=0; perf=0
    for a in "$@"; do case "$a" in --fix) fix=1;; --json) json=1;; --perf) perf=1;; esac; done
    (( fix )) && niru_doctor_fix
    (( perf )) && { nirupi_perf; exit 0; }
    if (( json )); then nirupi_doctor --json; else nirupi_doctor; fi;;
  config) printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/nirupi/status.conf";;
  history) printf 'Use: bash ~/Git/nirupi/install.sh --history\n';;
  rollback|theme|dots|migrate|apps|maintenance)
    if [[ -x "$HOME/.local/bin/nirupi-maintenance" ]]; then
      exec "$HOME/.local/bin/nirupi-maintenance" "$cmd" "$@"
    fi
    printf 'NIRUPI maintenance library not installed; run install.sh --apply to deploy it.\n' >&2
    exit 2;;
  agent) exec "$HOME/.local/bin/nirupi-agent.sh" "$@";;
  explain) exec "$HOME/.local/bin/nirupi-explain.sh" "$@";;
  mission) exec "$HOME/.local/bin/nirupi-mission.sh" "$@";;
  dwm) exec "$HOME/.local/bin/nirupi-dwm.sh" "$@";;
  snapshot) exec "$HOME/.local/bin/nirupi-snapshot.sh" "$@";;
  tune) exec "$HOME/.local/bin/nirupi-tune.sh" "$@";;
  menu) exec "$HOME/.local/bin/nirupi-menu.sh" "$@";;
  keys) exec "$HOME/.local/bin/nirupi-keys.sh" "$@";;
  backup) exec "$HOME/.local/bin/nirupi-backup.sh" "$@";;
  lock) exec "$HOME/.local/bin/nirupi-lock.sh" "$@";;
  webapp) exec "$HOME/.local/bin/nirupi-webapp.sh" "$@";;
  gc) exec "$HOME/.local/bin/nirupi-gc.sh" "$@";;
  update) exec "$HOME/.local/bin/nirupi-update.sh" "$@";;
  help|-h|--help) nirupi_help "${1:-}";;
  *) printf 'Unknown command: %s\n' "$cmd" >&2; exit 2;;
esac
