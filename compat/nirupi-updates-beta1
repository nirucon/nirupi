#!/usr/bin/env bash
# A single numeric update count. Never mutate the system or refresh package databases.
set -o pipefail
if command -v checkupdates >/dev/null 2>&1; then
  result=$(checkupdates 2>/dev/null) || { printf "0\n"; exit 0; }
  if [[ -z $result ]]; then printf '0\n'; else printf '%s\n' "$result" | wc -l; fi
elif command -v xbps-install >/dev/null 2>&1; then
  result=$(xbps-install -un 2>/dev/null) || { printf "0\n"; exit 0; }
  if [[ -z $result ]]; then printf '0\n'; else printf '%s\n' "$result" | wc -l; fi
elif command -v apt >/dev/null 2>&1; then
  LC_ALL=C apt list --upgradable 2>/dev/null | awk 'NR>1 && /upgradable/ {n++} END {print n+0}'
else
  printf '0\n'
fi
